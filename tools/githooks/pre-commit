#!/bin/sh
# Runs tools/pipeline_gate.py before every commit, made by Claude or by hand.
# Turn it on once per clone: git config core.hooksPath tools/githooks
# Skip it on purpose: git commit --no-verify
cd "$(git rev-parse --show-toplevel)" || exit 1
for py in python3.11 python3 python py; do
  if command -v "$py" >/dev/null 2>&1 && "$py" -c "import sys; sys.exit(sys.version_info < (3, 10))" 2>/dev/null; then
    exec "$py" tools/pipeline_gate.py --reuse --ledger
  fi
done
echo "pre-commit: no Python 3.10+ found to run tools/pipeline_gate.py" >&2
exit 1
